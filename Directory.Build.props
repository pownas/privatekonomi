<Project>

  <PropertyGroup Label="General">
    <TargetFramework>net11.0</TargetFramework>
    <AppVersion>0.1.0-beta</AppVersion>
    <Version>$(AppVersion)</Version>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <RepositoryUrl>https://github.com/pownas/privatekonomi</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Label="Version metadata">
    <BuildNumber Condition="'$(BuildNumber)' == ''">$(GITHUB_RUN_NUMBER)</BuildNumber>
  </PropertyGroup>

  <ItemGroup Label="Version metadata">
    <AssemblyMetadata Include="AppVersion" Value="$(AppVersion)" />
    <AssemblyMetadata Include="BuildNumber" Value="$(BuildNumber)" />
    <AssemblyMetadata Include="GitHubSha" Value="$(GITHUB_SHA)" />
  </ItemGroup>

  <PropertyGroup Label="Code style and quality">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Package manager configuration">
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <SatelliteResourceLanguages>sv;en</SatelliteResourceLanguages>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <PropertyGroup Label="Suppress warnings">
    <!-- Suppress NU1608 until Pomelo.EntityFrameworkCore.MySql releases 10.0 compatible version -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

</Project>
