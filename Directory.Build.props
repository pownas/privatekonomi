<Project>

  <PropertyGroup Label="General">
    <TargetFramework>net11.0</TargetFramework>
    <AppVersion>0.1.0-alfa</AppVersion>
    <Version>$(AppVersion)</Version>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Code style and quality">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Package manager configuration">
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <SatelliteResourceLanguages>sv;en</SatelliteResourceLanguages>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <PropertyGroup Label="Suppress warnings">
    <!-- Suppress NU1608 until Pomelo.EntityFrameworkCore.MySql releases 10.0 compatible version -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

</Project>
