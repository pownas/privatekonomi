@page "/admin/drift"
@page "/settings/pi-update"
@attribute [Authorize(Policy = "PiUpdateAdmin")]
@implements IAsyncDisposable
@using System.Diagnostics
@using System.Runtime.InteropServices
@using Microsoft.JSInterop
@using Privatekonomi.Web.Services
@inject PiUpdateService Updates
@inject SiteChangeHistoryService SiteChanges
@inject IWebHostEnvironment HostEnvironment
@inject IConfiguration Configuration
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Drift</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.overline">SYSTEM · DRIFT</MudText>
    <MudText Typo="Typo.h4">Drift</MudText>
    <MudText Class="mb-3">Överblick och säkra driftåtgärder för Privatekonomi.</MudText>

    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.CheckCircle" Class="mb-4">
        Webbappen är igång. Statusen uppdateras automatiskt var femte sekund.
        <MudText Typo="Typo.caption" Class="mt-1">Senast kontrollerad @_lastStatusRefreshAt.ToLocalTime().ToString("HH:mm:ss")</MudText>
    </MudAlert>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Devices" Class="mb-4">
        Öppnad adress: <strong>@NavigationManager.BaseUri</strong><br />
        På mobil/iPad betyder <code>localhost</code> själva mobilen. Använd serverns lokala IP-adress på samma Wi-Fi om appen körs på en annan dator eller Raspberry Pi.
    </MudAlert>

    @if (_history is null)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }
    else
    {
        <MudCard Class="mb-4">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="drift-card-heading">
                    <MudText Typo="Typo.h6">Uppdateringar från main</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                               OnClick="CheckForUpdatesAsync" Disabled="@_isCheckingUpdates">
                        @(_isCheckingUpdates ? "Söker..." : "Sök efter uppdateringar")
                    </MudButton>
                </MudStack>
                <MudText Typo="Typo.caption" Class="mb-3">Senast kontrollerad @_lastUpdateCheckAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudText>

                @if (_history.StatusMessage is not null)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3">@_history.StatusMessage</MudAlert>
                }
                else if (_history.InstalledCommit is null || _history.LatestCommit is null)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3">
                        Det går inte att avgöra om en uppdatering finns eftersom versionsinformationen saknas.
                    </MudAlert>
                }
                else if (_history.InstalledCommit == _history.LatestCommit)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.CheckCircle" Class="mb-3">
                        Du har senaste versionen från main installerad.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.SystemUpdateAlt" Class="mb-3">
                        En nyare version finns på main. Läs ändringarna nedan och välj sedan Installera uppdatering.
                    </MudAlert>
                }

                <MudSimpleTable Dense="true" Hover="true">
                    <tbody>
                        <tr><td>Installerad version</td><td class="text-end drift-commit">@FormatCommit(_history.InstalledCommit)</td></tr>
                        <tr><td>Senaste på main</td><td class="text-end drift-commit">@FormatCommit(_history.LatestCommit)</td></tr>
                    </tbody>
                </MudSimpleTable>

                @if (_history.InstalledCommit is not null && _history.LatestCommit is not null && _history.InstalledCommit != _history.LatestCommit)
                {
                    var changes = GetChangesSinceInstalled();
                    @if (changes.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Det här innehåller uppdateringen</MudText>
                        @if (!_history.Commits.Any(commit => commit.IsInstalled))
                        {
                            <MudText Typo="Typo.caption" Class="mb-2">Den installerade versionen är äldre än de senast hämtade ändringarna. Visar de fem senaste commitsen på main.</MudText>
                        }
                        <MudStack Spacing="2">
                            @foreach (var commit in changes)
                            {
                                <MudPaper Outlined="true" Class="pa-3">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="drift-commit-heading">
                                        <MudText Typo="Typo.subtitle2">@commit.Title</MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@commit.ShortSha</MudChip>
                                    </MudStack>
                                    @if (commit.Summary is not null)
                                    {
                                        <MudText Typo="Typo.body2" Class="mt-1">@commit.Summary</MudText>
                                    }
                                    <MudText Typo="Typo.caption" Class="mt-1">
                                        @commit.Author@if (commit.AuthoredAt is not null) { <span> · @commit.AuthoredAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span> }
                                    </MudText>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                    @if (_history.CompareUrl is not null)
                    {
                        <MudButton Href="@_history.CompareUrl" Target="_blank" Rel="noopener noreferrer"
                                   Variant="Variant.Text" StartIcon="@Icons.Material.Filled.OpenInNew" Class="mt-2">
                            Visa alla ändringar på GitHub
                        </MudButton>
                    }
                }
            </MudCardContent>
        </MudCard>

        <MudCard Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6">Åtgärdsstatus</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">@GetStatusLabel(_status.State)</MudText>

                @if (_status.State is "queued" or "running")
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mb-3" />
                    <MudAlert Severity="Severity.Info" Class="mb-3">Åtgärden körs. Knapparna är låsta tills den är klar.</MudAlert>
                }
                else if (_status.State == "blocked")
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">Automatisk återställning misslyckades. Åtgärda felet manuellt innan du startar en ny åtgärd.</MudAlert>
                }
                else if (Updates.IsAvailable)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                        Omstarten bryter anslutningen en kort stund. Vid uppdatering byggs och installeras vald gren innan Web och API startas igen.
                    </MudAlert>
                    <MudStack Spacing="2" Class="drift-actions">
                        @if (_branches.Count > 0)
                        {
                            <MudSelect T="string" Label="Gren att installera" @bind-Value="_selectedBranch" Variant="Variant.Outlined" Disabled="@_isBusy">
                                @foreach (var branch in _branches)
                                {
                                    <MudSelectItem T="string" Value="@branch">@branch</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning">Grenlistan kunde inte hämtas från GitHub. Försök igen senare.</MudAlert>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.SystemUpdateAlt" OnClick="ConfirmUpdateAsync"
                                   Disabled="@(_isBusy || _branches.Count == 0)">
                            Installera vald gren
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ConfirmRestartAsync" Disabled="@_isBusy">
                            Starta om Web och API
                        </MudButton>
                    </MudStack>
                    <form id="drift-update-form" method="post" action="/settings/pi-update/start" hidden>
                        <AntiforgeryToken />
                        <input type="hidden" name="branch" value="@_selectedBranch" />
                    </form>
                    <form id="drift-restart-form" method="post" action="/settings/pi-update/restart" hidden>
                        <AntiforgeryToken />
                    </form>
                }
                else
                {
                    <MudAlert Severity="Severity.Info">
                        Omstart och installation via sidan är aktiverade för en konfigurerad 64-bitars Raspberry Pi-installation. Den här servern stöder inte åtgärderna.
                    </MudAlert>
                }
            </MudCardContent>
        </MudCard>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Class="mb-4">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Applikation</MudText>
                        <MudSimpleTable Dense="true" Hover="true" Class="mt-2">
                            <tbody>
                                <tr><td>Miljö</td><td class="text-end">@HostEnvironment.EnvironmentName</td></tr>
                                <tr><td>.NET</td><td class="text-end">@RuntimeInformation.FrameworkDescription</td></tr>
                                <tr><td>Operativsystem</td><td class="text-end">@RuntimeInformation.OSDescription</td></tr>
                                <tr><td>Arkitektur</td><td class="text-end">@RuntimeInformation.ProcessArchitecture</td></tr>
                                <tr><td>Lagring</td><td class="text-end">@Configuration["Storage:Provider"]</td></tr>
                                <tr><td>Process startad</td><td class="text-end">@_processStartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td></tr>
                                <tr><td>Drifttid</td><td class="text-end">@FormatUptime(DateTimeOffset.Now - _processStartedAt)</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudButton Href="/admin/site-changes" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.History" Class="mb-4">
            Visa versionshistorik
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(_status.Log))
        {
            <MudCard Class="mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Senaste driftlogg</MudText>
                    <pre class="drift-log">@_status.Log</pre>
                </MudCardContent>
            </MudCard>
        }
    }
</MudContainer>

@code {
    private PiUpdateStatus _status = new("disabled", null, "main", string.Empty);
    private SiteChangeHistory? _history;
    private IReadOnlyList<string> _branches = Array.Empty<string>();
    private string _selectedBranch = "main";
    private DateTimeOffset _processStartedAt;
    private DateTimeOffset _lastStatusRefreshAt;
    private DateTimeOffset _lastUpdateCheckAt;
    private CancellationTokenSource? _pollCancellation;
    private Task? _pollTask;
    private IJSObjectReference? _module;
    private bool _isCheckingUpdates;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        _processStartedAt = new DateTimeOffset(Process.GetCurrentProcess().StartTime);
        RefreshLocalStatus();
        var historyTask = SiteChanges.GetRecentChangesAsync();
        var branchesTask = Updates.IsAvailable
            ? SiteChanges.GetBranchesAsync()
            : Task.FromResult<IReadOnlyList<string>>(Array.Empty<string>());
        await Task.WhenAll(historyTask, branchesTask);
        _history = await historyTask;
        _branches = await branchesTask;
        _selectedBranch = _branches.Contains(_status.InstalledBranch, StringComparer.Ordinal)
            ? _status.InstalledBranch
            : _branches.Contains("main", StringComparer.Ordinal) ? "main" : _branches.FirstOrDefault() ?? "main";
        _lastUpdateCheckAt = DateTimeOffset.Now;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Drift.razor.js");
        _pollCancellation = new CancellationTokenSource();
        _pollTask = PollStatusAsync(_pollCancellation.Token);
    }

    private async Task PollStatusAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    var previousState = _status.State;
                    RefreshLocalStatus();
                    if ((previousState is "queued" or "running") && (_status.State is "succeeded" or "restarted"))
                    {
                        _history = await SiteChanges.GetRecentChangesAsync(cancellationToken: cancellationToken);
                        _lastUpdateCheckAt = DateTimeOffset.Now;
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task CheckForUpdatesAsync()
    {
        _isCheckingUpdates = true;
        try
        {
            _history = await SiteChanges.GetRecentChangesAsync();
            _lastUpdateCheckAt = DateTimeOffset.Now;
        }
        finally
        {
            _isCheckingUpdates = false;
        }
    }

    private void RefreshLocalStatus()
    {
        _status = Updates.GetStatus();
        _lastStatusRefreshAt = DateTimeOffset.Now;
    }

    private IReadOnlyList<SiteChangeCommit> GetChangesSinceInstalled()
    {
        if (_history is null)
            return Array.Empty<SiteChangeCommit>();

        var installedIndex = _history.Commits.ToList().FindIndex(commit => commit.IsInstalled);
        return installedIndex >= 0
            ? _history.Commits.Take(installedIndex).ToArray()
            : _history.Commits.Take(5).ToArray();
    }

    private async Task ConfirmUpdateAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Installera uppdatering",
            $"Senaste versionen från grenen '{_selectedBranch}' hämtas och byggs. Web och API startas om och sidan kan kopplas från en stund. Vill du fortsätta?",
            yesText: "Installera",
            cancelText: "Avbryt");
        if (confirmed == true)
            await SubmitActionAsync("drift-update-form");
    }

    private async Task ConfirmRestartAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Starta om Web och API",
            "Webbappen och API:t startas om. Anslutningen bryts tillfälligt. Vill du fortsätta?",
            yesText: "Starta om",
            cancelText: "Avbryt");
        if (confirmed == true)
            await SubmitActionAsync("drift-restart-form");
    }

    private async Task SubmitActionAsync(string formId)
    {
        if (_module is null)
            return;

        _isBusy = true;
        await _module.InvokeVoidAsync("submitForm", formId);
    }

    private static string FormatCommit(string? sha) =>
        sha is { Length: >= 8 } ? $"{sha[..8]} ({sha})" : "Okänd";

    private static string GetStatusLabel(string state) => state switch
    {
        "queued" => "Väntar på start",
        "running" => "Åtgärd pågår",
        "succeeded" => "Uppdatering lyckades",
        "restarted" => "Omstart lyckades",
        "failed" => "Misslyckades – se loggen",
        "blocked" => "Återställning misslyckades – manuell åtgärd krävs",
        _ => "Ingen åtgärd pågår"
    };

    private static string FormatUptime(TimeSpan uptime) =>
        $"{(int)uptime.TotalDays} d {uptime.Hours} h {uptime.Minutes} min";

    public async ValueTask DisposeAsync()
    {
        if (_pollCancellation is not null)
        {
            await _pollCancellation.CancelAsync();
            if (_pollTask is not null)
                await _pollTask;
            _pollCancellation.Dispose();
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
