@page "/Account/Manage/Passkeys"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Privatekonomi.Core.Models
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Hantera passkeys</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">Hantera passkeys</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            Passkeys låter dig logga in med exempelvis enhetens biometriska autentisering eller säkerhetsnyckel.
        </MudText>

        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (!_supportsPasskeys)
        {
            <MudAlert Severity="Severity.Warning">Passkeys stöds inte av den aktuella datalagringen.</MudAlert>
        }
        else if (_passkeys.Count > 0)
        {
            <MudList T="string" Class="mb-4">
                @foreach (var passkey in _passkeys)
                {
                    <MudListItem>
                        @(string.IsNullOrWhiteSpace(passkey.Name) ? "Passkey" : passkey.Name)
                    </MudListItem>
                }
            </MudList>
        }
        else
        {
            <MudText Class="mb-4">Inga passkeys är registrerade för ditt konto.</MudText>
        }

        <MudAlert id="passkey-create-error" Severity="Severity.Error" Class="mb-4" Style="display: none;" />
        <MudAlert id="passkey-create-success" Severity="Severity.Success" Class="mb-4" Style="display: none;">
            Passkey har lagts till.
        </MudAlert>

        @if (!_isLoading && _supportsPasskeys)
        {
            <form id="passkey-create-form">
                <AntiforgeryToken />
                <MudButton id="passkey-create"
                           ButtonType="ButtonType.Button"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Fingerprint">
                    Lägg till passkey
                </MudButton>
            </form>
        }
    </MudPaper>
</MudContainer>

@code {
    private IList<UserPasskeyInfo> _passkeys = [];
    private bool _isLoading = true;
    private bool _supportsPasskeys;

    protected override async Task OnInitializedAsync()
    {
        _supportsPasskeys = UserManager.SupportsUserPasskey;
        if (_supportsPasskeys)
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authenticationState.User);
            if (user is not null)
            {
                _passkeys = await UserManager.GetPasskeysAsync(user);
            }
        }

        _isLoading = false;
    }
}
