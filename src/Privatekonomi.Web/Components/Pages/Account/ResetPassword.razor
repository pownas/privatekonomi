@page "/Account/Password/Reset"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Välj nytt lösenord</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">Välj nytt lösenord</MudText>
        @if (Invalid)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                Återställningslänken är ogiltig eller har gått ut. Begär en ny länk.
            </MudAlert>
        }
        @if (Invalid)
        {
            <MudText Align="Align.Center">
                <MudLink Href="/Account/ForgotPassword">Begär en ny återställningslänk</MudLink>
            </MudText>
        }
        else
        {
        <form method="post" action="/Account/Password/Reset">
            <AntiforgeryToken />
            <input type="hidden" name="Email" value="@Email" />
            <input type="hidden" name="Code" value="@Code" />
            <MudTextField T="string" Label="Nytt lösenord" InputType="InputType.Password" Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          UserAttributes="@(new Dictionary<string, object> { ["name"] = "Password", ["autocomplete"] = "new-password" })"
                          Required="true" />
            <MudTextField T="string" Label="Bekräfta lösenord" InputType="InputType.Password" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Class="mt-3"
                          UserAttributes="@(new Dictionary<string, object> { ["name"] = "ConfirmPassword", ["autocomplete"] = "new-password" })"
                          Required="true" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Class="mt-4">Spara nytt lösenord</MudButton>
        </form>
        }
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private bool Invalid => Error == "invalid" || string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Code);
}
