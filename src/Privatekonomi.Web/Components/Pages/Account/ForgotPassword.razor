@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Glömt lösenord</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">Återställ lösenord</MudText>
        @if (Sent)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Om kontot finns och e-postadressen är bekräftad skickar vi en återställningslänk.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4">Ange e-postadressen för ditt konto.</MudText>
            <form method="post" action="/Account/Password/Forgot">
                <AntiforgeryToken />
                <MudTextField T="string" Label="E-post" Variant="Variant.Outlined" Margin="Margin.Dense"
                              UserAttributes="@(new Dictionary<string, object> { ["name"] = "Email", ["type"] = "email", ["autocomplete"] = "email" })"
                              Required="true" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Class="mt-4">Skicka återställningslänk</MudButton>
            </form>
        }
        <MudText Align="Align.Center" Class="mt-4">
            <MudLink Href="/Account/Login">Tillbaka till inloggning</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "sent")]
    private bool Sent { get; set; }
}
