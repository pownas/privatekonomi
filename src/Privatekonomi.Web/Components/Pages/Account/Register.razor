@page "/Account/Register"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Registrera</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
            Skapa konto
        </MudText>
        
        @if (Registered)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Kontot är skapat. Kontrollera din e-post för att bekräfta adressen innan du loggar in.
            </MudAlert>
        }
        @if (ConfirmationResent)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Om kontot finns och ännu inte är bekräftat skickar vi en ny bekräftelselänk.
            </MudAlert>
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@ErrorMessage</MudAlert>
        }

        @if (ShowResendConfirmation)
        {
            <form method="post" action="/Account/Email/Resend" class="mb-4">
                <AntiforgeryToken />
                <MudTextField Label="E-post" Type="InputType.Email" UserAttributes="@(new Dictionary<string, object> { ["name"] = "Email", ["autocomplete"] = "email" })" Required="true" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">
                    Skicka bekräftelselänken igen
                </MudButton>
            </form>
        }

        @if (!Registered && Error != "email")
        {
        <form method="post" action="/Account/PerformRegister">
            <AntiforgeryToken />
            <MudTextField Label="Förnamn" 
                          @bind-Value="FirstName"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4"
                          UserAttributes="@(new Dictionary<string, object> { ["name"] = "FirstName", ["autocomplete"] = "given-name" })"
                          Required="true" />
            
            <MudTextField Label="Efternamn" 
                          @bind-Value="LastName"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4"
                          UserAttributes="@(new Dictionary<string, object> { ["name"] = "LastName", ["autocomplete"] = "family-name" })"
                          Required="true" />
            
            <MudTextField Label="E-post" 
                          @bind-Value="Email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4"
                          UserAttributes="@(new Dictionary<string, object> { ["name"] = "Email", ["autocomplete"] = "username" })"
                          Required="true" />
            
            <MudTextField Label="Lösenord" 
                          @bind-Value="Password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4"
                          UserAttributes="@(new Dictionary<string, object> { ["name"] = "Password", ["autocomplete"] = "new-password" })"
                          Required="true" />
            
            <MudTextField Label="Bekräfta lösenord" 
                          @bind-Value="ConfirmPassword"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4"
                          UserAttributes="@(new Dictionary<string, object> { ["name"] = "ConfirmPassword", ["autocomplete"] = "new-password" })"
                          Required="true" />
            
            <MudButton ButtonType="ButtonType.Submit" 
                       Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       FullWidth="true"
                       Class="mb-4">
                Registrera
            </MudButton>
        </form>
        }
        
        <MudText Align="Align.Center">
            Har du redan ett konto? <MudLink Href="/Account/Login">Logga in</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "details")]
    private string? Details { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    private bool Registered { get; set; }

    [SupplyParameterFromQuery(Name = "resend")]
    private bool ConfirmationResent { get; set; }

    private string FirstName { get; set; } = "";
    private string LastName { get; set; } = "";
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";

    private string? ErrorMessage => Error switch
    {
        "empty" or "required" => "Förnamn, efternamn, e-post och lösenord krävs.",
        "passwordmismatch" => "Lösenorden matchar inte.",
        "email" => "Kontot skapades, men bekräftelselänken kunde inte skickas. Försök skicka länken igen eller kontakta support.",
        "create" => GetCreateErrorMessage(),
        _ => null
    };

    private bool ShowResendConfirmation => Registered || Error == "email" || ConfirmationResent;

    private string GetCreateErrorMessage()
    {
        if (string.IsNullOrEmpty(Details))
            return "Kunde inte skapa konto: Okänt fel";
        
        // Translate common Identity error codes to Swedish
        return Details switch
        {
            var d when d.Contains("PasswordTooShort") => "Lösenordet måste vara minst 12 tecken.",
            var d when d.Contains("DuplicateUserName") => "E-postadressen är redan registrerad.",
            var d when d.Contains("DuplicateEmail") => "E-postadressen är redan registrerad.",
            var d when d.Contains("InvalidEmail") => "Ogiltig e-postadress.",
            _ => $"Kunde inte skapa konto: {Details}"
        };
    }
}
