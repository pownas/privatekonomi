@page "/settings/pi-update"
@page "/admin/site-changes"
@attribute [Authorize(Policy = "PiUpdateAdmin")]
@using Privatekonomi.Web.Services
@inject PiUpdateService Updates
@inject SiteChangeHistoryService SiteChanges

<PageTitle>Senaste ändringar</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4">Senaste ändringar</MudText>
    <MudText Class="mb-4">Visar de senaste uppdateringarna på sajten för systemadministratörer.</MudText>

    @if (_history is null)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Installerad version</MudText>
                        <MudText Typo="Typo.body1">@FormatCommit(_history.InstalledCommit, "Versionsinformation saknas")</MudText>
                        @if (_history.InstalledCommit is not null && _history.LatestCommit is not null && _history.InstalledCommit == _history.LatestCommit)
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Class="mt-2">Senaste versionen är installerad</MudChip>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Senaste commit på main</MudText>
                        <MudText Typo="Typo.body1">@FormatCommit(_history.LatestCommit, "Kan inte kontrolleras just nu")</MudText>
                        @if (_history.CompareUrl is not null)
                        {
                            <MudButton Href="@_history.CompareUrl" Target="_blank" Rel="noopener noreferrer" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.OpenInNew" Class="mt-2">
                                Se vad som är nytt
                            </MudButton>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @if (_history.StatusMessage is not null)
        {
            <MudAlert Severity="Severity.Info" Class="my-4">@_history.StatusMessage</MudAlert>
        }

        <MudText Typo="Typo.h5" Class="mt-6 mb-3">Senaste commits</MudText>
        @if (_history.Commits.Count == 0)
        {
            <MudAlert Severity="Severity.Info">Det finns inga commits att visa just nu.</MudAlert>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var commit in _history.Commits)
                {
                    <MudCard>
                        <MudCardContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                <MudText Typo="Typo.h6">@commit.Title</MudText>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    @if (commit.IsInstalled)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Installerad</MudChip>
                                    }
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@commit.ShortSha</MudChip>
                                </MudStack>
                            </MudStack>
                            @if (commit.Summary is not null)
                            {
                                <MudText Typo="Typo.body2" Class="mb-2">@commit.Summary</MudText>
                            }
                            <MudText Typo="Typo.caption">
                                @commit.Author
                                @if (commit.AuthoredAt is not null)
                                {
                                    <span> • @commit.AuthoredAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                }
                            </MudText>
                            @if (commit.CommitUrl is not null)
                            {
                                <MudButton Href="@commit.CommitUrl" Target="_blank" Rel="noopener noreferrer" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew" Class="mt-2">
                                    Öppna commit
                                </MudButton>
                            }
                        </MudCardContent>
                    </MudCard>
                }
            </MudStack>
        }

        @if (Updates.IsAvailable)
        {
            <MudDivider Class="my-6" />
            <MudText Typo="Typo.h5" Class="mb-3">Raspberry Pi-uppdatering</MudText>
            <MudAlert Severity="Severity.Warning" Class="my-4">
                Appen startas om vid uppdatering. Anslutningen kan brytas tillfälligt och du kan behöva logga in igen.
                Ladda om sidan efter några minuter för att se resultatet.
            </MudAlert>
            <MudText>Status: @(_status?.State switch
            {
                "queued" => "Väntar på start",
                "running" => "Uppdatering pågår",
                "succeeded" => "Uppdateringen lyckades",
                "failed" => "Uppdateringen misslyckades – se logg och återställningsguide",
                "blocked" => "Återställningen misslyckades – manuell åtgärd krävs innan ny uppdatering",
                _ => "Ingen uppdatering pågår"
            })</MudText>
            @if (_status?.State is not ("queued" or "running" or "blocked"))
            {
                <form method="post" action="/settings/pi-update/start" class="mt-3">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                        Starta uppdatering
                    </MudButton>
                </form>
            }
            <MudButton Href="/admin/site-changes" Variant="Variant.Text" Class="mt-2">Uppdatera status</MudButton>
            <MudText Typo="Typo.h6" Class="mt-4">Uppdateringslogg</MudText>
            <pre style="white-space: pre-wrap; overflow-wrap: anywhere">@(_status?.Log ?? "")</pre>
        }
    }
</MudContainer>

@code {
    private PiUpdateStatus? _status;
    private SiteChangeHistory? _history;

    protected override async Task OnInitializedAsync()
    {
        _status = Updates.GetStatus();
        _history = await SiteChanges.GetRecentChangesAsync();
    }

    private static string FormatCommit(string? sha, string fallback) =>
        sha is { Length: >= 8 } ? $"{sha[..8]} ({sha})" : fallback;
}
