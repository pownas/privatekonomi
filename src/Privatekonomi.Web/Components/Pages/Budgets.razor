@page "/economy/budgets"
@page "/budgets"
@rendermode InteractiveServer
@using Privatekonomi.Web.Components.Shared
@inject IBudgetService BudgetService
@inject IBudgetAlertService BudgetAlertService
@inject ICategoryService CategoryService
@inject IHouseholdService HouseholdService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Budget - Privatekonomi</PageTitle>

@* Budget Alerts Section *@
@if (_activeAlerts.Any())
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Error" Class="mr-2" />
            Aktiva Budgetvarningar (@_activeAlerts.Count())
        </MudText>
        
        @foreach (var alert in _activeAlerts.Take(3))
        {
            var budgetCategory = _budgets
                .SelectMany(b => b.BudgetCategories)
                .FirstOrDefault(bc => bc.BudgetCategoryId == alert.BudgetCategoryId);
            
            if (budgetCategory != null)
            {
                <BudgetAlertCard Alert="@alert" 
                               BudgetCategory="@budgetCategory"
                               OnAlertAcknowledged="@LoadAlertsAsync" />
            }
        }
        
        @if (_activeAlerts.Count() > 3)
        {
            <MudText Typo="Typo.body2" Class="mt-2">
                Och @(_activeAlerts.Count() - 3) fler varningar...
            </MudText>
        }
    </MudPaper>
}

<PageHeader Title="Budgethantering" Icon="@Icons.Material.Filled.PieChart">
    <Actions>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Default" 
                   StartIcon="@Icons.Material.Filled.Settings"
                   Href="/budgets/settings">
            Inställningar
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Info" 
                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                   Href="/budgets/builder">
            Budgetbyggare
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Secondary" 
                   StartIcon="@Icons.Material.Filled.AutoMode"
                   OnClick="CreateNextMonthBudgets">
            Skapa Nästa Månads Budgetar
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add" 
                   OnClick="ToggleCreateForm">
            Ny Budget
        </MudButton>
    </Actions>
</PageHeader>

@if (_showCreateForm || _editingBudget != null)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">@(_editingBudget != null ? "Redigera Budget" : "Skapa Ny Budget")</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_newBudget.Name" 
                             Label="Budgetnamn" 
                             Variant="Variant.Outlined" 
                             Required="true"
                             MaxLength="200"
                             Class="mb-3" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudRadioGroup @bind-Value="_newBudget.Period" Class="mb-3">
                    <MudText Typo="Typo.body2" Class="mb-2">Period</MudText>
                    <MudRadio Value="@BudgetPeriod.Monthly" Color="Color.Primary">Månadsbudget</MudRadio>
                    <MudRadio Value="@BudgetPeriod.Yearly" Color="Color.Primary">Årsbudget</MudRadio>
                </MudRadioGroup>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_newBudgetStartDateString" 
                              Label="Startdatum (ÅÅÅÅ-MM-DD)" 
                              Variant="Variant.Outlined"
                              Placeholder="2025-01-01"
                              Class="mb-3" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_newBudgetEndDateString" 
                              Label="Slutdatum (ÅÅÅÅ-MM-DD)" 
                              Variant="Variant.Outlined"
                              Placeholder="2025-01-31"
                              Class="mb-3" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="_newBudget.HouseholdId" 
                          Label="Hushåll (valfritt)" 
                          Variant="Variant.Outlined"
                          Clearable="true"
                          Class="mb-3">
                    @foreach (var household in _households)
                    {
                        <MudSelectItem Value="@((int?)household.HouseholdId)">@household.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_newBudget.Description" 
                             Label="Beskrivning (valfritt)" 
                             Variant="Variant.Outlined"
                             Lines="3"
                             MaxLength="500"
                             Class="mb-3" />
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h6" Class="mb-3">Budgetmall</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="_selectedTemplate" Label="Välj budgetmall" Variant="Variant.Outlined" 
                           T="BudgetTemplateType" Class="mb-3">
                    <MudSelectItem Value="@BudgetTemplateType.Custom">Anpassad (tom mall)</MudSelectItem>
                    <MudSelectItem Value="@BudgetTemplateType.SwedishFamily">Svenska Familjehushåll (Rekommenderad)</MudSelectItem>
                    <MudSelectItem Value="@BudgetTemplateType.SwedishSingle">Svenska Singelhushåll (Rekommenderad)</MudSelectItem>
                    <MudSelectItem Value="@BudgetTemplateType.FiftyThirtyTwenty">50/30/20-regeln</MudSelectItem>
                    <MudSelectItem Value="@BudgetTemplateType.ZeroBased">Zero-based budgeting</MudSelectItem>
                    <MudSelectItem Value="@BudgetTemplateType.Envelope">Kuvertbudget</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_totalIncome" 
                                Label="Total månadsinkomst" 
                                Variant="Variant.Outlined"
                                Format="N2"
                                Culture="@(new System.Globalization.CultureInfo("sv-SE"))"
                                Adornment="Adornment.Start"
                                AdornmentText="kr"
                                Min="0"
                                Step="1000M"
                                HideSpinButtons="false"
                                Class="mb-3"
                                HelperText="Används för att beräkna budgetmallar" />
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    @BudgetTemplateService.GetTemplateDescription(_selectedTemplate)
                </MudAlert>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary" 
                           OnClick="ApplyTemplate"
                           Disabled="@(_totalIncome <= 0)"
                           StartIcon="@Icons.Material.Filled.AutoAwesome">
                    Använd mall
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h6" Class="mb-3">Budgetposter per kategori</MudText>
        <MudAlert Severity="Severity.Success" Class="mb-3" Icon="@Icons.Material.Filled.Lightbulb">
            <MudText Typo="Typo.body2" Class="mb-2"><strong>Tips för en lyckad hushållsbudget:</strong></MudText>
            <ul style="margin: 0; padding-left: 20px;">
                <li><strong>Se sparande som en månadskostnad</strong> - Sparandet ska alltid dras i början av månaden så att det inte bortprioriteras.</li>
                <li><strong>Dela upp matkostnader</strong> - Separera mat du handlar i butik från mat du handlar på restaurang för bättre kontroll.</li>
                <li><strong>Gör varje månad kostnadsneutral</strong> - För årskostnader (t.ex. fritidsaktiviteter 2400 kr/år = 200 kr/månad), använd periodväljaren nedan.</li>
            </ul>
        </MudAlert>
        <MudAlert Severity="Severity.Info" Class="mb-3">
            För varje kategori kan du ange en periodkostnad (månadsvis, varannan månad, kvartal, halvår eller helår). 
            Systemet beräknar automatiskt månadskostnaden som läggs till i budgeten.
        </MudAlert>
        <MudGrid>
            @foreach (var category in _categories)
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-3 mb-2" Elevation="1">
                        <MudGrid>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">
                                    <MudChip T="string" 
                                            Style="@($"background-color: {category.Color}; color: white;")" 
                                            Size="Size.Small">
                                        @category.Name
                                    </MudChip>
                                </MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect @bind-Value="@_categoryPeriods[category.CategoryId]" 
                                          Label="Period" 
                                          Variant="Variant.Outlined"
                                          dense="true">
                                    <MudSelectItem Value="@(1)">Månad</MudSelectItem>
                                    <MudSelectItem Value="@(2)">Varannan månad</MudSelectItem>
                                    <MudSelectItem Value="@(3)">Kvartal (3 mån)</MudSelectItem>
                                    <MudSelectItem Value="@(6)">Halvår (6 mån)</MudSelectItem>
                                    <MudSelectItem Value="@(12)">Helår (12 mån)</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField @bind-Value="@_categoryBudgets[category.CategoryId]"
                                                Label="@GetPeriodLabel(_categoryPeriods[category.CategoryId])"
                                                Variant="Variant.Outlined"
                                                Format="N2"
                                                Culture="@(new System.Globalization.CultureInfo("sv-SE"))"
                                                Adornment="Adornment.Start"
                                                AdornmentText="kr"
                                                Min="0"
                                                Step="100M"
                                                HideSpinButtons="false"
                                                dense="true" />
                            </MudItem>
                            @if (_categoryBudgets[category.CategoryId] > 0 && _categoryPeriods[category.CategoryId] > 1)
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Success" dense="true">
                                        Månadskostnad: @((_categoryBudgets[category.CategoryId] / _categoryPeriods[category.CategoryId]).ToString("C", new System.Globalization.CultureInfo("sv-SE")))
                                    </MudAlert>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(_editingBudget != null ? SaveEditedBudget : CreateBudget)">
                @(_editingBudget != null ? "Spara" : "Skapa")
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="CancelEdit">Avbryt</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <LoadingIndicator Message="Laddar budgetar..." />
    }
    else
    {
        @if (!_budgets.Any())
        {
            <EmptyState IconName="@Icons.Material.Filled.PieChart"
                        IconColor="Color.Secondary"
                        Title="Inga budgetar än"
                        Description="Skapa din första budget för att börja planera och följa upp din ekonomi. Välj mellan månads- eller årsbudget."
                        ActionText="Skapa Din Första Budget"
                        ActionIcon="@Icons.Material.Filled.Add"
                        OnActionClick="ToggleCreateForm"
                        SecondaryText="Använd Budgetbyggaren"
                        SecondaryHref="/budgets/builder" />
        }
        else
        {
            @foreach (var budget in _budgets)
            {
                <MudExpansionPanels Class="mb-3">
                    <MudExpansionPanel>
                        <TitleContent>
                            <div class="d-flex justify-space-between align-center" style="width: 100%;">
                                <div>
                                    <MudText Typo="Typo.h6">@budget.Name</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @budget.StartDate.ToString("yyyy-MM-dd") - @budget.EndDate.ToString("yyyy-MM-dd") 
                                        (@(budget.Period == BudgetPeriod.Monthly ? "Månadsbudget" : "Årsbudget"))
                                    </MudText>
                                </div>
                                <div>
                                    @if (IsBudgetActive(budget))
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Aktiv</MudChip>
                                    }
                                    else if (budget.EndDate < DateTime.Now)
                                    {
                                        <MudChip T="string" Color="Color.Default" Size="Size.Small">Avslutad</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small">Kommande</MudChip>
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                 Color="Color.Primary" 
                                                 Size="Size.Small"
                                                 OnClick="@(() => StartEditBudget(budget))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                 Color="Color.Error" 
                                                 Size="Size.Small"
                                                 OnClick="@(async () => await DeleteBudget(budget))" />
                                </div>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            @if (!string.IsNullOrEmpty(budget.Description))
                            {
                                <MudText Class="mb-3">@budget.Description</MudText>
                            }
                            
                            <MudDivider Class="mb-3" />
                            
                            @if (_budgetActualAmounts.ContainsKey(budget.BudgetId))
                            {
                                var actualAmounts = _budgetActualAmounts[budget.BudgetId];
                                var totalPlannedMonthly = budget.BudgetCategories.Sum(bc => bc.MonthlyAmount);
                                var totalActual = actualAmounts.Values.Sum();
                                
                                <div class="mb-4">
                                    <MudText Typo="Typo.h6" Class="mb-2">Sammanfattning</MudText>
                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.body2">Total Månadskostnad:</MudText>
                                            <MudText Typo="Typo.h6">@totalPlannedMonthly.ToString("C", new System.Globalization.CultureInfo("sv-SE"))</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.body2">Faktiskt Utfall:</MudText>
                                            <MudText Typo="Typo.h6">@totalActual.ToString("C", new System.Globalization.CultureInfo("sv-SE"))</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.body2">Kvar att Spendera:</MudText>
                                            <MudText Typo="Typo.h6" Color="@(totalPlannedMonthly - totalActual >= 0 ? Color.Success : Color.Error)">
                                                @((totalPlannedMonthly - totalActual).ToString("C", new System.Globalization.CultureInfo("sv-SE")))
                                            </MudText>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                                
                                <MudDivider Class="mb-3" />
                                
                                <MudText Typo="Typo.h6" Class="mb-3">Budgetposter per kategori</MudText>
                                <MudTable Items="@budget.BudgetCategories" dense="true" Hover="true" Striped="true">
                                    <HeaderContent>
                                        <MudTh>Kategori</MudTh>
                                        <MudTh>Period</MudTh>
                                        <MudTh>Periodbelopp</MudTh>
                                        <MudTh>Månadskostnad</MudTh>
                                        <MudTh>Faktiskt</MudTh>
                                        <MudTh>Differens</MudTh>
                                        <MudTh>Progress</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>
                                            <MudChip T="string" 
                                                    Style="@($"background-color: {context.Category.Color}; color: white;")" 
                                                    Size="Size.Small">
                                                @context.Category.Name
                                            </MudChip>
                                        </MudTd>
                                        <MudTd>
                                            @if (context.RecurrencePeriodMonths > 1)
                                            {
                                                <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                                    @GetPeriodText(context.RecurrencePeriodMonths)
                                                </MudChip>
                                            }
                                            else
                                            {
                                                <span>Månad</span>
                                            }
                                        </MudTd>
                                        <MudTd>
                                            @if (context.RecurrencePeriodMonths > 1)
                                            {
                                                @context.PlannedAmount.ToString("C", new System.Globalization.CultureInfo("sv-SE"))
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </MudTd>
                                        <MudTd>
                                            <strong>@context.MonthlyAmount.ToString("C", new System.Globalization.CultureInfo("sv-SE"))</strong>
                                        </MudTd>
                                        <MudTd>
                                            @{
                                                var actual = actualAmounts.ContainsKey(context.CategoryId) ? actualAmounts[context.CategoryId] : 0;
                                            }
                                            @actual.ToString("C", new System.Globalization.CultureInfo("sv-SE"))
                                        </MudTd>
                                        <MudTd>
                                            @{
                                                var actual = actualAmounts.ContainsKey(context.CategoryId) ? actualAmounts[context.CategoryId] : 0;
                                                var diff = context.MonthlyAmount - actual;
                                            }
                                            <MudText Color="@(diff >= 0 ? Color.Success : Color.Error)">
                                                @diff.ToString("C", new System.Globalization.CultureInfo("sv-SE"))
                                            </MudText>
                                        </MudTd>
                                        <MudTd>
                                            @{
                                                var actual = actualAmounts.ContainsKey(context.CategoryId) ? actualAmounts[context.CategoryId] : 0;
                                                var percentage = context.MonthlyAmount > 0 ? (double)(actual / context.MonthlyAmount) * 100 : 0;
                                                var progressColor = percentage <= 75 ? Color.Success : percentage <= 100 ? Color.Warning : Color.Error;
                                            }
                                            <MudProgressLinear Color="@progressColor" 
                                                             Size="Size.Large"
                                                             Value="@percentage" 
                                                             Min="0" 
                                                             Max="100"
                                                             Class="my-1">
                                                <MudText Typo="Typo.body2" Color="Color.Surface">
                                                    @percentage.ToString("F0")%
                                                </MudText>
                                            </MudProgressLinear>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                            else
                            {
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        }
    }
</MudPaper>

@code {
    private bool _loading = true;
    private bool _showCreateForm = false;
    private Budget? _editingBudget = null;
    private IEnumerable<Budget> _budgets = new List<Budget>();
    private IEnumerable<BudgetAlert> _activeAlerts = new List<BudgetAlert>();
    private IEnumerable<Category> _categories = new List<Category>();
    private IEnumerable<Household> _households = new List<Household>();
    private Budget _newBudget = new();
    private string _newBudgetStartDateString = DateTime.Now.ToString("yyyy-MM-dd");
    private string _newBudgetEndDateString = DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd");
    private Dictionary<int, decimal> _categoryBudgets = new();
    private Dictionary<int, int> _categoryPeriods = new(); // New: track recurrence period for each category
    private Dictionary<int, Dictionary<int, decimal>> _budgetActualAmounts = new();
    private BudgetTemplateType _selectedTemplate = BudgetTemplateType.Custom;
    private decimal _totalIncome = 30000m; // Default Swedish median income

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadAlertsAsync();
    }

    private async Task LoadData()
    {
        _loading = true;
        _categories = await CategoryService.GetAllCategoriesAsync();
        _budgets = await BudgetService.GetAllBudgetsAsync();
        _households = await HouseholdService.GetAllHouseholdsAsync();
        
        // Initialize category budgets and periods dictionaries
        _categoryBudgets = _categories.ToDictionary(c => c.CategoryId, c => 0m);
        _categoryPeriods = _categories.ToDictionary(c => c.CategoryId, c => 1); // Default to monthly
        
        // Load actual amounts for all budgets
        foreach (var budget in _budgets)
        {
            var actualAmounts = await BudgetService.GetActualAmountsByCategoryAsync(budget.BudgetId);
            _budgetActualAmounts[budget.BudgetId] = actualAmounts;
        }
        
        _loading = false;
    }

    private void ToggleCreateForm()
    {
        _showCreateForm = !_showCreateForm;
        _editingBudget = null;
        if (_showCreateForm)
        {
            _newBudget = new Budget
            {
                Period = BudgetPeriod.Monthly
            };
            _newBudgetStartDateString = DateTime.Now.ToString("yyyy-MM-dd");
            _newBudgetEndDateString = DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd");
            _categoryBudgets = _categories.ToDictionary(c => c.CategoryId, c => 0m);
            _categoryPeriods = _categories.ToDictionary(c => c.CategoryId, c => 1);
            _selectedTemplate = BudgetTemplateType.Custom;
        }
    }

    private void StartEditBudget(Budget budget)
    {
        _editingBudget = budget;
        _showCreateForm = false;
        
        // Pre-fill the form with existing budget data
        _newBudget = new Budget
        {
            BudgetId = budget.BudgetId,
            Name = budget.Name,
            Description = budget.Description,
            Period = budget.Period,
            HouseholdId = budget.HouseholdId,
            TemplateType = budget.TemplateType,
            RolloverUnspent = budget.RolloverUnspent,
            UserId = budget.UserId
        };
        
        _newBudgetStartDateString = budget.StartDate.ToString("yyyy-MM-dd");
        _newBudgetEndDateString = budget.EndDate.ToString("yyyy-MM-dd");
        
        // Pre-fill category budgets and periods
        _categoryBudgets = _categories.ToDictionary(c => c.CategoryId, c => 0m);
        _categoryPeriods = _categories.ToDictionary(c => c.CategoryId, c => 1);
        foreach (var bc in budget.BudgetCategories)
        {
            _categoryBudgets[bc.CategoryId] = bc.PlannedAmount;
            _categoryPeriods[bc.CategoryId] = bc.RecurrencePeriodMonths;
        }
        
        _selectedTemplate = budget.TemplateType ?? BudgetTemplateType.Custom;
    }

    private void CancelEdit()
    {
        _showCreateForm = false;
        _editingBudget = null;
        _newBudget = new Budget();
    }
    
    private string GetPeriodLabel(int months)
    {
        return months switch
        {
            1 => "Belopp/månad",
            2 => "Belopp/varannan månad",
            3 => "Belopp/kvartal",
            6 => "Belopp/halvår",
            12 => "Belopp/år",
            _ => "Belopp"
        };
    }

    private async Task SaveEditedBudget()
    {
        if (string.IsNullOrWhiteSpace(_newBudget.Name))
        {
            Snackbar.Add("Budgetnamn är obligatoriskt", Severity.Error);
            return;
        }

        if (!DateTime.TryParse(_newBudgetStartDateString, out var startDate) || 
            !DateTime.TryParse(_newBudgetEndDateString, out var endDate))
        {
            Snackbar.Add("Ogiltigt datumformat. Använd ÅÅÅÅ-MM-DD", Severity.Error);
            return;
        }

        if (endDate < startDate)
        {
            Snackbar.Add("Slutdatum måste vara efter startdatum", Severity.Error);
            return;
        }

        try
        {
            _newBudget.StartDate = startDate;
            _newBudget.EndDate = endDate;
            
            // Get the existing budget from database to update it properly
            var existingBudget = await BudgetService.GetBudgetByIdAsync(_newBudget.BudgetId);
            if (existingBudget == null)
            {
                Snackbar.Add("Budgeten kunde inte hittas", Severity.Error);
                return;
            }

            // Update basic properties
            existingBudget.Name = _newBudget.Name;
            existingBudget.Description = _newBudget.Description;
            existingBudget.StartDate = startDate;
            existingBudget.EndDate = endDate;
            existingBudget.Period = _newBudget.Period;
            existingBudget.HouseholdId = _newBudget.HouseholdId;
            existingBudget.TemplateType = _selectedTemplate;

            // Update budget categories with recurrence periods
            existingBudget.BudgetCategories.Clear();
            existingBudget.BudgetCategories = _categoryBudgets
                .Where(kvp => kvp.Value > 0)
                .Select(kvp => new BudgetCategory
                {
                    BudgetId = existingBudget.BudgetId,
                    CategoryId = kvp.Key,
                    PlannedAmount = kvp.Value,
                    RecurrencePeriodMonths = _categoryPeriods[kvp.Key]
                })
                .ToList();

            if (!existingBudget.BudgetCategories.Any())
            {
                Snackbar.Add("Lägg till minst en budgetpost", Severity.Warning);
                return;
            }

            await BudgetService.UpdateBudgetAsync(existingBudget);
            Snackbar.Add("Budget uppdaterad!", Severity.Success);
            _editingBudget = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fel vid uppdatering av budget: {ex.Message}", Severity.Error);
        }
    }

    private void ApplyTemplate()
    {
        if (_totalIncome <= 0)
        {
            Snackbar.Add("Ange total månadsinkomst först", Severity.Warning);
            return;
        }

        try
        {
            _categoryBudgets = BudgetTemplateService.ApplyTemplate(_selectedTemplate, _totalIncome, _categories);
            _newBudget.TemplateType = _selectedTemplate;
            Snackbar.Add($"Budgetmall '{_selectedTemplate}' tillämpad", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ett fel uppstod: {ex.Message}", Severity.Error);
        }
    }

    private async Task CreateBudget()
    {
        if (string.IsNullOrWhiteSpace(_newBudget.Name))
        {
            Snackbar.Add("Budgetnamn är obligatoriskt", Severity.Error);
            return;
        }

        if (!DateTime.TryParse(_newBudgetStartDateString, out var startDate) || 
            !DateTime.TryParse(_newBudgetEndDateString, out var endDate))
        {
            Snackbar.Add("Ogiltigt datumformat. Använd ÅÅÅÅ-MM-DD", Severity.Error);
            return;
        }

        if (endDate < startDate)
        {
            Snackbar.Add("Slutdatum måste vara efter startdatum", Severity.Error);
            return;
        }

        try
        {
            _newBudget.StartDate = startDate;
            _newBudget.EndDate = endDate;
            
            // Add budget categories with non-zero amounts and their recurrence periods
            _newBudget.BudgetCategories = _categoryBudgets
                .Where(kvp => kvp.Value > 0)
                .Select(kvp => new BudgetCategory
                {
                    CategoryId = kvp.Key,
                    PlannedAmount = kvp.Value,
                    RecurrencePeriodMonths = _categoryPeriods[kvp.Key]
                })
                .ToList();

            if (!_newBudget.BudgetCategories.Any())
            {
                Snackbar.Add("Lägg till minst en budgetpost", Severity.Warning);
                return;
            }

            await BudgetService.CreateBudgetAsync(_newBudget);
            Snackbar.Add("Budget skapad!", Severity.Success);
            _showCreateForm = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fel vid skapande av budget: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteBudget(Budget budget)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Bekräfta borttagning",
            $"Är du säker på att du vill ta bort budgeten '{budget.Name}'?",
            yesText: "Ta bort", cancelText: "Avbryt");
        if (result == true)
        {
            try
            {
                await BudgetService.DeleteBudgetAsync(budget.BudgetId);
                Snackbar.Add("Budget borttagen!", Severity.Success);
                await LoadData();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Fel vid borttagning av budget: {ex.Message}", Severity.Error);
            }
        }
    }

    private bool IsBudgetActive(Budget budget)
    {
        var now = DateTime.Now;
        return budget.StartDate <= now && budget.EndDate >= now;
    }
    
    private string GetPeriodText(int months)
    {
        return months switch
        {
            1 => "Månad",
            2 => "Varannan månad",
            3 => "Kvartal",
            6 => "Halvår",
            12 => "Helår",
            _ => $"{months} månader"
        };
    }

    private async Task CreateNextMonthBudgets()
    {
        try
        {
            var createdBudgets = await BudgetService.CreateNextMonthBudgetsForAllActiveAsync();
            
            if (createdBudgets.Any())
            {
                Snackbar.Add($"{createdBudgets.Count()} budget(ar) skapade för nästa månad!", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("Inga budgetar behöver skapas. Budgetar skapas automatiskt under de sista 3 dagarna av månaden.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fel vid skapande av nästa månads budgetar: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadAlertsAsync()
    {
        try
        {
            _activeAlerts = await BudgetAlertService.GetActiveAlertsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kunde inte ladda budgetvarningar: {ex.Message}", Severity.Error);
        }
    }
