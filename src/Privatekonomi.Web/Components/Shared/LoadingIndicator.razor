<div class="d-flex flex-column align-center pa-6" role="status" aria-live="polite" aria-busy="true">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">@Message</MudText>
</div>

@code {
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
}
