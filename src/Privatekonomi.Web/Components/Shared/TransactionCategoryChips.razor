@using Privatekonomi.Core.Models

@if (Transaction.IsInternalTransferTransaction)
{
    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
             OnClick="ChangeCategory"
             aria-label="@($"Ändra kategori för {Transaction.Description}")">
        Överföring mellan egna konton
    </MudChip>
}
else if (Transaction.IsExcludedFromTotals)
{
    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
             OnClick="ChangeCategory"
             aria-label="@($"Ändra kategori för {Transaction.Description}")">
        Övrig utan kategorisering
    </MudChip>
}
else if (Transaction.TransactionCategories.Any())
{
    @foreach (var transactionCategory in Transaction.TransactionCategories)
    {
        <MudChip T="string"
                 Size="Size.Small"
                 Variant="Variant.Filled"
                 OnClick="ChangeCategory"
                 aria-label="@($"Ändra kategori för {Transaction.Description}")"
                 Style="@($"background-color: {transactionCategory.Category.Color}; color: white; margin: 2px;")">
            @transactionCategory.Category.Name
        </MudChip>
    }
}
else
{
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
             OnClick="ChangeCategory"
             aria-label="@($"Ändra kategori för {Transaction.Description}")">
        Okategoriserad
    </MudChip>
}

@code {
    [Parameter, EditorRequired] public Transaction Transaction { get; set; } = null!;
    [Parameter] public EventCallback<Transaction> OnCategoryChange { get; set; }

    private Task ChangeCategory() => OnCategoryChange.InvokeAsync(Transaction);
}
