{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiSettings": {
    "BaseUrl": "http://localhost:5277"
  },
  "Storage": {
    "Note": "You can change from JsonFile to other providers like Sqlite, MySql, or SqlServer by updating the Provider and ConnectionString.",
    "Provider": "JsonFile",
    "ConnectionString": "./data",
    "SeedTestData": false
  },
  "BankSync": {
    "Enabled": false,
    "IntervalMinutes": 60
  },
  "Swedbank": {
    "ClientId": "your-swedbank-client-id",
    "ClientSecret": "your-swedbank-client-secret",
    "Environment": "production"
  },
  "Avanza": {
    "Note": "Avanza won't use PSD2 but a proprietary API. No client ID/secret is required, instead use username and password when connecting via the UI."
  },
  "IcaBanken": {
    "ClientId": "your-ica-client-id",
    "ClientSecret": "your-ica-client-secret",
    "Environment": "production"
  }
}
